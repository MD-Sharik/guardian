# ─────────────────────────────────────────────────────────────
# Guardian configuration. Copy to `.env` (python dev.py setup does it).
# Jev is required. Every other integration is optional and shows as
# "off" in the dashboard until configured. Nothing is ever faked.
# Check what works with:  python dev.py doctor
# ─────────────────────────────────────────────────────────────

# ── Jev (TypeSafe AI) · REQUIRED ─────────────────────────────
# Served through OpenCode Zen (https://opencode.ai/docs/zen/). Key: opencode.ai/console → Keys.
# jev-1.13-free is free for a limited time; jev-1.13 costs $0.042 per 1M input tokens.
JEV_API_KEY=
JEV_BASE_URL=https://opencode.ai/zen
JEV_MODEL=jev-1.13-free
# Alternatives: TypeSafe directly (key from console.typesafe.ai/keys, leave
# JEV_BASE_URL empty, JEV_MODEL=jev-latest), or OpenRouter
# (JEV_BASE_URL=https://openrouter.ai/api, JEV_MODEL=~typesafe/jev-latest).

# ── NeatLogs · traces every decision ─────────────────────────
# Key: https://app.neatlogs.com/settings/api-keys   Docs: https://docs.neatlogs.com
NEATLOGS_API_KEY=
# Project name, required by the HTTP ingest endpoint when using a write key.
NEATLOGS_PROJECT=guardian
# EU projects: https://eu.ingest.neatlogs.com
NEATLOGS_INGEST_URL=https://ingest.neatlogs.com
NEATLOGS_APP_URL=https://app.neatlogs.com

# ── Entire · the agent's captured session ────────────────────
# Needs the `entire` CLI (https://docs.entire.io/installation). For Antigravity
# Guardian reads the session in the project folder the agent reports, so these
# are only needed for other agents or a non-PATH install.
ENTIRE_REPO_PATH=
ENTIRE_BIN=entire

# ── LLM · plain-English explanations + the LangGraph example agent ──
# Any OpenAI-compatible /chat/completions endpoint. Set up for a Modal Shared
# Endpoint serving DeepSeek; copy the URL from the endpoint's page (keep the /v1).
LLM_BASE_URL=https://md-sharik--ep-guardian-server.us-west.modal.direct/v1
LLM_MODEL=deepseek-ai/DeepSeek-V4.1-Flash
# Modal workspace proxy token: shown on the endpoint page ("workspace settings" link).
# Guardian sends it as `Authorization: Bearer <id>.<secret>`.
MODAL_PROXY_TOKEN_ID=
MODAL_PROXY_TOKEN_SECRET=
# For any other OpenAI-compatible provider, put its key here instead.
LLM_API_KEY=

# ── Guardian service ─────────────────────────────────────────
GUARDIAN_HOST=127.0.0.1
GUARDIAN_PORT=8000
GUARDIAN_DB_PATH=guardian-service/guardian.db
# Seconds an escalation stays open in the dashboard before it expires.
GUARDIAN_ESCALATION_TIMEOUT=300

# ── Antigravity hook (written into the hook command by install-antigravity) ──
# How long Antigravity waits for your answer in the dashboard on ESCALATE before
# falling back to its own approval prompt. Keep it below GUARDIAN_ESCALATION_TIMEOUT.
GUARDIAN_HOOK_WAIT=240
# What an ALLOW verdict tells Antigravity: "allow" runs the tool without asking,
# "ask" keeps Antigravity's own permission prompts (Guardian then only adds denials).
GUARDIAN_ON_ALLOW=allow

# Policy thresholds (see guardian-service/app/policy.py)
GUARDIAN_BLOCK_SAFE_BELOW=0.30
GUARDIAN_ALLOW_SAFE_ABOVE=0.75
GUARDIAN_MIN_CONFIDENCE=0.50
GUARDIAN_SEVERITY_ESCALATE=1.5
GUARDIAN_SEVERITY_BLOCK=2.3
GUARDIAN_RISK_BLOCK=0.70
GUARDIAN_ON_TASK_MIN=0.40
GUARDIAN_OUTPUT_OK_MIN=0.40

# ── Clients ──────────────────────────────────────────────────
# Used by guardian-sdk and the example agent
GUARDIAN_URL=http://127.0.0.1:8000
# Used by the dashboard (browser-side)
NEXT_PUBLIC_GUARDIAN_URL=http://127.0.0.1:8000
